APP_NAME=AegisOps AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./aegisops.db

# Generate a unique 32+ character secret for non-development environments.
JWT_SECRET_KEY=replace-with-a-random-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LOG_LEVEL=INFO
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_knowledge
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=
ALLOWED_HOSTS=
DOCS_ENABLED=true

# Docker Compose only
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
