APP_NAME=AegisOps AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Local development may use SQLite. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./aegisops.db

# Replace in every real environment.
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_knowledge
REDIS_URL=redis://localhost:6379/0

# Comma-separated allow lists.
CORS_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1
DOCS_ENABLED=true
LOG_LEVEL=INFO

# Docker Compose PostgreSQL password.
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
